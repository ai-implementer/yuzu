<!DOCTYPE html>
<html lang="{{ site.lang }}" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }} | {{ site.title }}</title>
{% if page.description %}<meta name="description" content="{{ page.description }}">
{% endif %}{# URL 系の値はこちらで生成した安全な文字列なので safe を通す（/ の実体参照化を避ける） #}
<link rel="stylesheet" href="{{ asset_url | safe }}css/theme.css">
<link rel="stylesheet" href="{{ asset_url | safe }}css/syntect.css">
{% if theme_css_vars %}{# yuzu.jsonc theme.cssVars 由来（値は render 側で検証済み） #}<style>
{{ theme_css_vars | safe }}</style>
{% endif %}{% if math_enabled %}<link rel="stylesheet" href="{{ asset_url | safe }}vendor/katex/katex.min.css">
{% endif %}{% if dark_enabled %}<script>
// FOUC 回避: CSS 適用前に保存済みテーマ（なければ OS 設定）を反映する
(function () {
  var stored = null;
  try { stored = localStorage.getItem("yuzu-theme"); } catch (e) {}
  var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  document.documentElement.dataset.theme = theme;
})();
</script>
{% endif %}</head>
<body>
<a class="skip-link" href="#yuzu-main">本文へ移動</a>
{% include "partials/header.jinja" %}
<div class="layout">
{% include "partials/sidebar.jinja" %}
{# 左サイドバーのスクロール位置をページ遷移をまたいで保つ（プログレッシブエンハンスメント）。
   復元は最初のペイントより前に済ませる必要があるため、body 末尾の外部 JS ではなくここに置く
   （head の FOUC 回避スクリプトと同じ理由）。パーサ挿入の script は head のスタイルシート
   適用を待ってから走るので、この時点の実測レイアウトは最終値と一致する #}
<script data-base="{{ base_url | safe }}">
(function () {
  var sidebar = document.getElementById("site-sidebar");
  if (!sidebar) return;
  // 同一オリジンに複数の yuzu サイトが並ぶ場合（GitHub Pages のサブパス配下など）に
  // 衝突しないよう baseUrl で名前空間を切る。タブ内で完結させたいので sessionStorage
  var base = (document.currentScript && document.currentScript.dataset.base) || "/";
  var key = "yuzu-sidebar-scroll:" + base;

  // 狭幅では sidebar が position: static / display: none になり独立スクロールしない。
  // メディアクエリではなく実測で判定する（テーマ CSS を上書きされても追随する）
  function scrollable() {
    return sidebar.scrollHeight > sidebar.clientHeight;
  }

  function save() {
    if (!scrollable()) return; // 狭幅の 0 で広幅の値を潰さない
    try {
      sessionStorage.setItem(key, String(sidebar.scrollTop));
    } catch (e) {
      /* プライベートブラウジング等では保存しない */
    }
  }

  // 現在ページの項目がはみ出しているときだけ最小限寄せる（scrollspy.js の keepVisible と同じ）。
  // サイドバーのリンクから来た場合は可視域内なので動かず、復元位置がそのまま残る。
  // a は display:block、offsetParent は position:sticky な .sidebar（狭幅では外れるので弾く）
  function keepActiveVisible() {
    var a = sidebar.querySelector("li.active > a");
    if (!a || a.offsetParent !== sidebar) return;
    var margin = 8;
    var top = a.offsetTop;
    var bottom = top + a.offsetHeight;
    if (top < sidebar.scrollTop + margin) {
      sidebar.scrollTop = top - margin;
    } else if (bottom > sidebar.scrollTop + sidebar.clientHeight - margin) {
      sidebar.scrollTop = bottom - sidebar.clientHeight + margin;
    }
  }

  if (scrollable()) {
    var saved = NaN;
    try {
      saved = parseInt(sessionStorage.getItem(key), 10);
    } catch (e) {}
    if (saved > 0) sidebar.scrollTop = saved;
    keepActiveVisible();
  }

  var timer = null;
  sidebar.addEventListener(
    "scroll",
    function () {
      clearTimeout(timer);
      timer = setTimeout(save, 200);
    },
    { passive: true }
  );
  // 遷移直前の確定保存。beforeunload はモバイル Safari で発火が不安定なため使わない。
  // bfcache 復帰時はブラウザが scrollTop ごと復元するので pageshow では何もしない
  window.addEventListener("pagehide", save);
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "hidden") save();
  });
})();
</script>
<main class="content" id="yuzu-main">
{% include "partials/toc-mobile.jinja" %}
{% block content %}{% endblock %}
</main>
{% include "partials/toc.jinja" %}
</div>
<script src="{{ asset_url | safe }}js/theme.js"></script>
<script src="{{ asset_url | safe }}js/nav.js"></script>
<script src="{{ asset_url | safe }}js/scrollspy.js"></script>
<script src="{{ asset_url | safe }}js/copy-button.js"></script>
<script src="{{ asset_url | safe }}js/page-copy.js"></script>
<script src="{{ asset_url | safe }}js/details-target.js"></script>
{% if mermaid_enabled %}<script src="{{ asset_url | safe }}vendor/mermaid.min.js"></script>
<script src="{{ asset_url | safe }}js/mermaid-init.js"></script>
{% endif %}{% if math_enabled %}<script src="{{ asset_url | safe }}vendor/katex/katex.min.js"></script>
<script src="{{ asset_url | safe }}js/katex-init.js"></script>
{% endif %}{% if search_enabled %}<script type="module" src="{{ asset_url | safe }}js/search-ui.js" data-search-base="{{ base_url | safe }}_search/" data-base="{{ base_url | safe }}"></script>
{% endif %}{% if live_reload_poll %}<script src="{{ asset_url | safe }}js/autorefresh.js" data-base="{{ base_url | safe }}"></script>
{% endif %}{% if live_reload_ws %}<script src="{{ asset_url | safe }}js/livereload.js"></script>
{% endif %}</body>
</html>
