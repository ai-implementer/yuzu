<script src="https://example.com/docs/_assets/js/mermaid-init.js"></script>
<script type="module" src="https://example.com/docs/_assets/js/search-ui.js" data-search-base="https://example.com/docs/_search/" data-base="https://example.com/docs/" data-search-page="https://example.com/docs/search/"></script>
</body>
</html>
